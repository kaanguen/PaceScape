# Normalize text files; keep Unity YAML and source files in regular Git.
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.meta text eol=lf

# Binary source assets managed by Git LFS.

# Images and textures
*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
